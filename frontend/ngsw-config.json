{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/*.css", "/*.js", "/manifest.webmanifest", "/seed.json"]
      }
    },
    {
      "name": "images",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/brand.png",
          "/bitacora-icon.svg",
          "/bitacora-icon-192.png",
          "/bitacora-icon-512.png",
          "/favicon.ico",
          "/route-cover.png"
        ]
      }
    }
  ]
}
